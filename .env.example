# CausalGame Environment Variables Template
# Copy this file to .env and fill in your actual values

# ===== API Keys (set the ones for the providers you use) =====
# OpenAI (GPT series)
# OPENAI_API_KEY=your_openai_api_key_here

# DeepSeek official API (DeepSeek V4 Pro / V4 Flash) — uses the OpenAI-compatible
# client but requires its own key, read from DEEPSEEK_API_KEY
# DEEPSEEK_API_KEY=your_deepseek_api_key_here

# Anthropic (Claude series)
# ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Google AI Studio (Gemini series)
# GEMINI_API_KEY=your_gemini_api_key_here

# xAI (Grok series)
# XAI_API_KEY=your_xai_api_key_here

# OpenRouter (GLM, Kimi, MiniMax, Qwen, and other models)
# OPENROUTER_API_KEY=your_openrouter_api_key_here

# ===== Configuration =====
# Override backend URL (defaults to value in config/server.json)
# API_BASE_URL=http://localhost:8000

# Agent model selection (defaults to config/agent.json "default")
# Run 'python run_agent.py --list-models' to see all available models
# AGENT_MODEL=gpt-5-mini

# Default scenario served by the backend
# CAUSALGAME_EXPERIMENT=antenna_trap

# ===== Timezone =====
# Override default timezone from config/server.json (defaults to UTC)
# TIMEZONE=UTC

# ===== Development Settings =====
# DEBUG=true
# LOG_LEVEL=INFO
