  "execution": {
    "max_turns": 50,
    "max_tool_iterations_per_turn": 5,
    "timeout_per_turn_seconds": 120,
    "total_timeout_seconds": 3600,
    "auto_reset_on_start": true,
    "enable_self_reflection": true
  },
  "code_execution": {
    "allowed_libraries": [
      "pandas",
      "numpy",
      "requests",
      "json",
      "time"
    ],
    "max_execution_time_seconds": 10,
    "enable_retry_on_error": true,
    "max_retries": 3
  },
  "system_instruction": {
    "template": "default",
    "templates": {
      "default": {
        "include_causal_hints": false,
        "include_budget_tips": true,
        "include_environment_tips": true,
        "verbosity": "detailed"
      },
      "causal_aware": {
        "include_causal_hints": true,
        "include_budget_tips": true,
        "include_environment_tips": true,
        "verbosity": "detailed",
        "hints": [
          "Consider selection bias: are you only seeing survivors?",
          "Correlation does not imply causation",
          "Think about hidden confounders"
        ]
      },
      "minimal": {
        "include_causal_hints": false,
        "include_budget_tips": false,
        "include_environment_tips": false,
        "verbosity": "minimal"
      }
    }
  },
  "strategies": {
    "_comment": "Predefined agent strategy configurations",
    "exploratory": {
      "description": "Heavy exploration, minimal exploitation",
      "exploration_drones": 40,
      "min_experiments_before_submit": 10,
      "randomize_designs": true
    },
    "conservative": {
      "description": "Quickly find viable solution and submit",
      "exploration_drones": 20,
      "min_experiments_before_submit": 3,
      "randomize_designs": false
    },
    "analytical": {
      "description": "Deep data analysis before experimentation",
      "exploration_drones": 30,
      "min_experiments_before_submit": 5,
      "require_correlation_analysis": true,
      "require_environment_analysis": true
    }
  },
  "logging": {
    "log_to_server": true,
    "log_level": "INFO",
    "save_conversation": true,
    "conversation_dir": "./logs/conversations",
    "save_code_executions": true,
    "code_execution_dir": "./logs/code"
  },
  "reporting": {
    "enable_final_reflection": true,
    "include_metrics": true,
    "metrics_to_track": [
      "total_turns",
      "drones_used",
      "hp_used",
      "survival_rate",
      "code_execution_success_rate",
      "average_turn_time"
    ],
    "generate_markdown_report": true,
    "report_dir": "./logs/reports"
  },
  "experimental": {
    "_comment": "Experimental features, may be unstable",
    "enable_memory": false,
    "memory_size": 10,
    "enable_tool_use": false,
    "allowed_tools": [
      "web_search",
      "calculator"
    ],
    "enable_multi_agent": false,
    "agent_roles": [
      "explorer",
      "analyst",
      "decision_maker"
    ]
  }
}